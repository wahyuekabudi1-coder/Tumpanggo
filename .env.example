# ============================================================
# TUMPANG GO ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# ------------------------------------------------------------
# 1. CORE / HOSTING RUNTIME
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# 2. TUMPANG FOOD SERVICE (INDEPENDENT SERVICE 1)
# ------------------------------------------------------------
FOOD_PORT=3000
FOOD_ADMIN_EMAIL=admin@tumpanggo.com
FOOD_ADMIN_PASSWORD=
FOOD_AUTH_SECRET=
FOOD_DATABASE_ID=(default)
FOOD_DB_FILE=

# ------------------------------------------------------------
# 3. TUMPANG SHOP SERVICE (INDEPENDENT SERVICE 2)
# ------------------------------------------------------------
SHOP_PORT=3001
SHOP_ADMIN_EMAIL=shopadmin@tumpanggo.com
SHOP_ADMIN_PASSWORD=
SHOP_AUTH_SECRET=
SHOP_DATABASE_TYPE=file
SHOP_DB_FILE=tumpang_shop_db.json
SHOP_DATABASE_URL=
SHOP_ENABLE_CLOUD_SYNC=false
SHOP_FIRESTORE_DATABASE_ID=(default)
SHOP_FIRESTORE_PREFIX=shop_
SHOP_SERVICE_URL=

# ------------------------------------------------------------
# 4. FIREBASE CLOUD INFRASTRUCTURE
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=tumpanggo-70479
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------
# 5. ARTOPAY PAYMENT GATEWAY
# ------------------------------------------------------------
ARTOPAY_ENV=sandbox
ARTOPAY_ENVIRONMENT=sandbox
ARTOPAY_PUBLIC_KEY=
ARTOPAY_SECRET_KEY=
ARTOPAY_WEBHOOK_SECRET=
ARTOPAY_CLIENT_KEY=
ARTOPAY_API_KEY=
ARTOPAY_BASE_URL=
ARTOPAY_API_BASE_URL=
ARTOPAY_PAY_URL=
ARTOPAY_BUSINESS_UNIT_CODE=

# Client Exposed ArtoPay Keys
VITE_ARTOPAY_PUBLIC_KEY=
VITE_ARTOPAY_CLIENT_KEY=